-- autoheal

local tping = false
local currentPos = nil
local healPos = workspace.Map.Tower.Traps.buttons.Heal100Brick.Position
local function autohealin()
	local plr = game.Players.LocalPlayer
	local char = plr.Character or plr.CharacterAdded:Wait()
	local hum = char:FindFirstChild("Humanoid")
	local hrp = char:FindFirstChild("HumanoidRootPart")
	local health = hum.Health
	if char and not char:GetAttribute("Ragdoll") and hum and hrp then
		if health and health ~= 0 and health < 100 and not tping then
			currentPos = hrp.Position
			local targetPos = healPos + Vector3.new(0, -1, 0)
			hrp.CFrame = CFrame.new(targetPos)
			if (hrp.Position - targetPos).Magnitude < 5 then
				if hrp.CFrame == CFrame.new(targetPos) then
					tping = true
				end
			end
		end
		if tping then
			task.wait(0.5)
			if currentPos then
				hrp.CFrame = CFrame.new(currentPos)
				if hrp.CFrame == CFrame.new(currentPos) then
					currentPos = nil
					tping = false
				end
			end
		end
	end
end

